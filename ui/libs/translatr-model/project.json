{
  "name": "translatr-model",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/translatr-model/src",
  "projectType": "library",
  "prefix": "dev",
  "tags": [
    "lib"
  ],
  "targets": {
    "codegen": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        { "runtime": "shasum ../src/main/resources/META-INF/openapi.yaml" },
        "{workspaceRoot}/openapitools.json",
        "{workspaceRoot}/package.json"
      ],
      "outputs": ["{projectRoot}/src/lib/generated"],
      "options": {
        "command": "npm run generate:models"
      }
    },
    "lint": {
      "executor": "@angular-eslint/builder:lint",
      "options": {
        "lintFilePatterns": [
          "libs/translatr-model/**/*.ts"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "libs/translatr-model/jest.config.js",
        "tsConfig": "libs/translatr-model/tsconfig.spec.json"
      }
    }
  }
}
