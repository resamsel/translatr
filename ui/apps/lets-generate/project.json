{
  "name": "lets-generate",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/lets-generate/src",
  "projectType": "application",
  "prefix": "lets-generate",
  "tags": [
    "app"
  ],
  "generators": {},
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "options": {
        "outputPath": "dist/apps/lets-generate",
        "outputFileName": "main.js",
        "main": "apps/lets-generate/src/main.ts",
        "tsConfig": "apps/lets-generate/tsconfig.app.json",
        "platform": "node",
        "format": [
          "cjs"
        ],
        "bundle": true,
        "thirdParty": false,
        "generatePackageJson": false,
        "esbuildOptions": {
          "outExtension": {
            ".js": ".js"
          }
        }
      },
      "configurations": {
        "production": {
          "minify": true
        }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "lets-generate:build"
      }
    },
    "lint": {
      "executor": "@angular-eslint/builder:lint",
      "options": {
        "lintFilePatterns": [
          "apps/lets-generate/**/*.ts"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "apps/lets-generate/jest.config.js"
      }
    }
  }
}
