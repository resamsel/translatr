{
  "name": "@translatr/cli",
  "version": "0.1.0",
  "description": "Command line interface for Translatr",
  "type": "module",
  "bin": {
    "translatr": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build ./src/index.ts --outfile dist/index.js --target node --format esm --banner '#!/usr/bin/env node'",
    "compile:linux-x64": "bun build ./src/index.ts --compile --target=bun-linux-x64 --outfile dist/bin/translatr-linux-x64",
    "compile:linux-arm64": "bun build ./src/index.ts --compile --target=bun-linux-arm64 --outfile dist/bin/translatr-linux-arm64",
    "compile:macos-x64": "bun build ./src/index.ts --compile --target=bun-darwin-x64 --outfile dist/bin/translatr-macos-x64",
    "compile:macos-arm64": "bun build ./src/index.ts --compile --target=bun-darwin-arm64 --outfile dist/bin/translatr-macos-arm64",
    "compile:windows-x64": "bun build ./src/index.ts --compile --target=bun-windows-x64 --outfile dist/bin/translatr-windows-x64.exe",
    "compile:all": "bun run compile:linux-x64 && bun run compile:linux-arm64 && bun run compile:macos-x64 && bun run compile:macos-arm64 && bun run compile:windows-x64",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "glob": "^11.0.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "bun-types": "^1.1.0",
    "typescript": "^5.6.0"
  }
}
