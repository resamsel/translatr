{
  "name": "translatr-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "",
  "tags": [
    "e2e"
  ],
  "implicitDependencies": [
    "translatr"
  ],
  "targets": {
    "e2e": {
      "executor": "@nx/playwright:playwright",
      "options": {
        "config": "apps/translatr-e2e/playwright.config.ts"
      },
      "configurations": {
        "production": {}
      }
    },
    "lint": {
      "executor": "@angular-eslint/builder:lint",
      "options": {
        "lintFilePatterns": [
          "apps/translatr-e2e/**/*.ts"
        ]
      }
    }
  }
}
