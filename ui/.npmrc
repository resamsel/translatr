# Restore pre-npm7 peer dependency resolver (required for @ngneat/hotkeys peer dep conflict)
legacy-peer-deps=true

# Note: --openssl-legacy-provider was removed in Node 22+ and is NOT needed for Angular 11
# (webpack 4 ships its own JS-based MD4 implementation that doesn't rely on OpenSSL).
# Node 22+ (including 25+) is supported as-is.

