# Restore pre-npm7 peer dependency resolver (required for @ngneat/hotkeys peer dep conflict)
legacy-peer-deps=true

# Re-enable the legacy OpenSSL provider so the old webpack/Angular build can use MD4 hashing.
# Requires Node 18 or 20 LTS — see .node-version.
# Node 22+ removed this flag; do NOT upgrade Node for UI work beyond 20 LTS.
node-options=--openssl-legacy-provider

