{
  "name": "translatr-ui",
  "version": "3.3.3",
  "author": "René Panzar",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/resamsel/translatr/issues"
  },
  "homepage": "https://github.com/resamsel/translatr#readme",
  "scripts": {
    "ng": "ng",
    "prettier": "prettier --write \"{apps,libs}/**/*.{ts,css,scss}\"",
    "prettier:affected": "pretty-quick --pattern='ui/{apps,libs}/**/*.{ts,css,scss}'",
    "prestart": "npm run buildinfo",
    "prestart:admin": "npm run buildinfo && npm run generate",
    "generate:api": "openapi-generator-cli generate -i ../src/main/resources/META-INF/openapi.yaml -g typescript-angular -o libs/translatr-sdk/src/lib/generated --additional-properties=ngVersion=22.0.8,providedInRoot=true,withInterfaces=true,supportsES6=true,modelPropertyNaming=original",
    "postgenerate:api": "node tools/suppress-unused-generated-imports.js",
    "generate:model:access-token": "openapi-generator-cli generate -i ../src/main/resources/META-INF/openapi.yaml -g typescript-angular -o libs/translatr-model/src/lib/generated --global-property models=AccessTokenPayload",
    "generate:model:project": "openapi-generator-cli generate -i ../src/main/resources/META-INF/openapi.yaml -g typescript-angular -o libs/translatr-model/src/lib/generated --global-property models=ProjectPayload",
    "generate:model:member": "openapi-generator-cli generate -i ../src/main/resources/META-INF/openapi.yaml -g typescript-angular -o libs/translatr-model/src/lib/generated --global-property models=Member",
    "generate:model:message": "openapi-generator-cli generate -i ../src/main/resources/META-INF/openapi.yaml -g typescript-angular -o libs/translatr-model/src/lib/generated --global-property models=MessagePayload",
    "generate": "npm run generate:api && npm run generate:model:access-token && npm run generate:model:project && npm run generate:model:member && npm run generate:model:message",
    "start": "nx serve translatr --host 0.0.0.0 --port 4210",
    "start:admin": "nx serve translatr-admin --host 0.0.0.0 --port 4211",
    "start:docs": "ng serve docs --host 0.0.0.0 --port 4212",
    "start:lets-generate": "nx serve lets-generate",
    "lets-generate": "dist/lets-generate",
    "prereadme:lets-generate": "npm run build:lets-generate",
    "readme:lets-generate": "dist/lets-generate --document > ./libs/generator/README.md",
    "lint": "nx run-many --target=lint --all",
    "lint:fix": "nx run-many --target=lint --all --fix",
    "pretest": "npm run buildinfo && npm run generate",
    "test": "nx run-many --target=test --all --code-coverage=true",
    "e2e": "nx e2e translatr-e2e --configuration production",
    "e2e:ui:watch": "nx e2e translatr-e2e --watch",
    "coveralls": "cat ./coverage/*/*/lcov.info | coveralls",
    "prebuild": "npm run buildinfo && npm run generate",
    "build": "npm run lint && npm run test && npm run e2e && npm run build:prod",
    "prebuild:prod": "npm run buildinfo && npm run generate",
    "build:prod": "npm run build:ui:prod && npm run build:admin:prod",
    "prebuild:ui:prod": "npm run buildinfo && npm run generate",
    "build:ui:prod": "nx build translatr --configuration production --output-path ../public/ui",
    "prebuild:admin:prod": "npm run buildinfo && npm run generate",
    "build:admin:prod": "nx build translatr-admin --configuration production --output-path ../public/admin",
    "build:lets-generate": "nx build lets-generate",
    "postbuild:lets-generate": "tools/make-command.js dist/apps/lets-generate/main.js dist/lets-generate",
    "build:lets-generate:prod": "nx build lets-generate --configuration production",
    "postbuild:lets-generate:prod": "tools/make-command.js dist/apps/lets-generate/main.js dist/lets-generate",
    "prebuild:lets-generate:docker": "npm run build:lets-generate:prod",
    "build:lets-generate:docker": "docker build -t resamsel/translatr-loadgenerator:$npm_package_version .",
    "publish:lets-generate:docker": "docker push resamsel/translatr-loadgenerator:$npm_package_version",
    "buildinfo": "node tools/build-info.js",
    "postpull": "npm install",
    "precommit": "npm run prettier:affected && npm run build",
    "affected:apps": "nx affected --target=build --type=app",
    "affected:libs": "nx affected --target=build --type=lib",
    "affected:build": "nx affected --target=build",
    "affected:e2e": "nx affected --target=e2e",
    "affected:test": "nx affected --target=test",
    "affected:lint": "nx affected --target=lint",
    "affected:dep-graph": "nx graph --affected",
    "affected": "nx affected",
    "format": "nx format:write",
    "format:write": "nx format:write",
    "format:check": "nx format:check",
    "update": "ng update @nx/workspace",
    "update:check": "ng update",
    "dep-graph": "nx graph",
    "help": "nx help",
    "nx": "nx",
    "prebundle-report": "nx build translatr --configuration production --stats-json",
    "bundle-report": "webpack-bundle-analyzer dist/apps/translatr/stats-es2015.json",
    "i18n:extract": "transloco-keys-manager extract",
    "i18n:find": "transloco-keys-manager find",
    "i18n:pull": "npm run i18n:pull:ui && npm run i18n:pull:admin",
    "i18n:pull:ui": "cd apps/translatr && translatr pull",
    "i18n:pull:admin": "cd apps/translatr-admin && translatr pull",
    "i18n:push": "npm run i18n:push:ui && npm run i18n:push:admin",
    "i18n:push:ui": "cd apps/translatr && translatr push",
    "i18n:push:admin": "cd apps/translatr-admin && translatr push",
    "generate-icons": "svg-to-ts",
    "prepare": "cd .. && husky ui/.husky"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.0.8",
    "@angular/cdk": "22.0.7",
    "@angular/common": "22.0.8",
    "@angular/compiler": "22.0.8",
    "@angular/core": "22.0.8",
    "@angular/forms": "22.0.8",
    "@angular/localize": "22.0.8",
    "@angular/material": "22.0.7",
    "@angular/platform-browser": "22.0.8",
    "@angular/platform-browser-dynamic": "22.0.8",
    "@angular/router": "22.0.8",
    "@ctrl/ngx-codemirror": "^7.0.0",
    "@fortawesome/angular-fontawesome": "5.1.0",
    "@fortawesome/fontawesome-svg-core": "^6.5.0",
    "@fortawesome/free-brands-svg-icons": "^6.5.0",
    "@fortawesome/free-regular-svg-icons": "^6.5.0",
    "@fortawesome/free-solid-svg-icons": "^6.5.0",
    "@jsverse/transloco": "^7.6.0",
    "@jsverse/transloco-locale": "^7.0.0",
    "@jsverse/transloco-messageformat": "^7.0.0",
    "@jsverse/transloco-preload-langs": "^7.0.0",
    "@momothepug/tsmodule-alias": "^1.0.0",
    "@ngneat/hotkeys": "^4.1.0",
    "@ngneat/svg-icon": "^7.1.6",
    "@ngrx/effects": "22.0.0",
    "@ngrx/entity": "22.0.0",
    "@ngrx/router-store": "22.0.0",
    "@ngrx/store": "22.0.0",
    "@oclif/command": "1.6.1",
    "@oclif/config": "1.15.1",
    "@oclif/plugin-help": "^2.2.3",
    "cli-ux": "5.5.0",
    "codemirror": "^5.65.9",
    "d3": "^7.9.0",
    "d3-time": "^3.1.0",
    "globby": "11.0.1",
    "messageformat": "^2.3.0",
    "ngx-gravatar": "^13.0.0",
    "random-name": "^0.1.2",
    "runes": "^0.4.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "underscore": "^1.13.6",
    "xmlhttprequest": "1.8.0",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.1.6",
    "@angular-eslint/builder": "22.1.0",
    "@angular-eslint/eslint-plugin": "22.1.0",
    "@angular-eslint/eslint-plugin-template": "22.1.0",
    "@angular-eslint/schematics": "22.1.0",
    "@angular-eslint/template-parser": "22.1.0",
    "@angular/cli": "22.1.6",
    "@angular/compiler-cli": "22.0.8",
    "@angular/language-service": "22.0.8",
    "@eslint/js": "^9.0.0",
    "@jsverse/transloco-keys-manager": "^7.0.0",
    "@jsverse/transloco-optimize": "^7.0.0",
    "@jsverse/transloco-validator": "^7.0.0",
    "@ngneat/spectator": "^22.1.0",
    "@ngrx/store-devtools": "22.0.0",
    "@nx/angular": "23.1.2",
    "@nx/cypress": "23.1.2",
    "@nx/esbuild": "23.1.2",
    "@nx/eslint": "23.1.2",
    "@nx/jest": "23.1.2",
    "@nx/js": "23.1.2",
    "@nx/node": "23.1.2",
    "@nx/workspace": "23.1.2",
    "@oclif/dev-cli": "1.26.0",
    "@openapitools/openapi-generator-cli": "2.41.0",
    "@types/d3": "^7.4.0",
    "@types/d3-time": "^3.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "^18.19.0",
    "@types/underscore": "^1.11.0",
    "angular-eslint": "22.1.0",
    "cypress": "^15.21.1",
    "dateformat": "^5.0.3",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "jest": "30.5.0",
    "jest-environment-jsdom": "^30.0.0",
    "jest-junit": "^17.0.0",
    "jest-preset-angular": "17.0.0",
    "jest-transform-stub": "^2.0.0",
    "jest-util": "30.5.0",
    "lint-staged": "^15.0.0",
    "nx": "23.1.2",
    "prettier": "^3.3.0",
    "pretty-quick": "^4.0.0",
    "svg-to-ts": "^11.0.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.68.0",
    "webpack-bundle-analyzer": "^4.10.0"
  },
  "overrides": {
    "tmp": "^0.2.6"
  },
  "files": [
    "/dist/lets-generate"
  ],
  "oclif": {
    "commands": "./apps/lets-generate/src/commands",
    "bin": "translatr",
    "plugins": [
      "@oclif/plugin-help"
    ]
  },
  "lint-staged": {
    "apps/translatr*/src/assets/i18n/*.json": [
      "transloco-validator"
    ]
  },
  "svg-to-ts": {
    "generateType": "false",
    "delimiter": "KEBAB",
    "conversionType": "files",
    "iconsFolderName": "svg",
    "prefix": "app",
    "srcFiles": [
      "./assets/svg/*.svg"
    ],
    "outputDirectory": "./apps/translatr/src/assets",
    "svgoConfig": {
      "plugins": [
        {
          "removeDimensions": true,
          "cleanupAttrs": true
        }
      ]
    }
  }
}
